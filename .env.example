# copy to .env.local
# Postgres connection string. Leave unset to run in local/demo mode (no accounts, everything in the browser).
# Neon: use the pooled connection string, e.g. postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://localhost:5432/kinetic

# optional
ANTHROPIC_API_KEY=
FAL_KEY=
# set to 1 to reject MCP keys that were not issued from /connect (default: unknown well-formed kn_ keys are demo keys)
MCP_REQUIRE_REAL_KEYS=
# vitest DB tests (defaults to the line below)
# TEST_DATABASE_URL=postgres://localhost:5432/kinetic_test
